#!/bin/sh
# Pre-commit hook to run cargo fix and cargo fmt before each commit

# First, run cargo fix to automatically fix warnings (unused imports, etc.)
echo "🔧 Running cargo fix to resolve warnings..."
cargo fix --bin quickcsv --allow-dirty --allow-staged 2>/dev/null
if [ $? -eq 0 ]; then
    echo "✅ Warnings fixed."
else
    echo "⚠️  cargo fix had issues, continuing anyway..."
fi

# Run cargo fmt check
cargo fmt -- --check
if [ $? -ne 0 ]; then
    echo "❌ Code is not formatted. Running cargo fmt..."
    cargo fmt
    echo "✅ Code formatted. Please stage the changes and commit again."
    exit 1
fi

echo "✅ Code formatting check passed."
